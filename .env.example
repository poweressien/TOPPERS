# ─── Django Core ──────────────────────────────────────────────
SECRET_KEY=your-very-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgres://toppers_user:password@localhost:5432/toppers_db

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Email ────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=TOPPERS <noreply@toppers.ng>

# ─── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Paystack ─────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_xxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxx

# ─── VTPass (Airtime) ─────────────────────────────────────────
VTPASS_API_KEY=your-vtpass-api-key
VTPASS_PUBLIC_KEY=your-vtpass-public-key
VTPASS_SECRET_KEY=your-vtpass-secret-key
VTPASS_BASE_URL=https://vtpass.com/api

# ─── Media / Static ───────────────────────────────────────────
MEDIA_ROOT=/home/toppers/media/
STATIC_ROOT=/home/toppers/static/

# ─── Frontend URL ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Game Config ──────────────────────────────────────────────
DAILY_GAME_LIMIT=5
POINTS_TO_NAIRA_RATE=0.05
MIN_REDEMPTION_POINTS=2000
REFERRAL_BONUS_POINTS=500
DAILY_LOGIN_BONUS=50
