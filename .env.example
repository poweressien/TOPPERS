# ─── COPY THIS FILE TO .env AND FILL IN YOUR VALUES ───────────
# cp .env.example .env

# ─── Django Core ──────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secret-key-here
DEBUG=False
# Add your PythonAnywhere domain:
ALLOWED_HOSTS=yourusername.pythonanywhere.com,localhost

# ─── Database ─────────────────────────────────────────────────
# PythonAnywhere free tier MySQL format:
DATABASE_URL=mysql://yourusername:yourpassword@yourusername.mysql.pythonanywhere-services.com/yourusername$toppers
# Local development (SQLite - no setup needed):
# DATABASE_URL=sqlite:///db.sqlite3

# ─── Email ────────────────────────────────────────────────────
# Keep as console for now, switch to real SMTP when ready
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=TOPPERS <noreply@toppers.ng>

# ─── Google OAuth (optional — leave blank to disable) ─────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Paystack ─────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ─── VTPass Airtime API ───────────────────────────────────────
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
VTPASS_BASE_URL=https://sandbox.vtpass.com/api

# ─── Frontend URL ─────────────────────────────────────────────
FRONTEND_URL=https://yourusername.pythonanywhere.com

# ─── Game Config ──────────────────────────────────────────────
DAILY_GAME_LIMIT=5
POINTS_TO_NAIRA_RATE=0.05
MIN_REDEMPTION_POINTS=2000
REFERRAL_BONUS_POINTS=500
DAILY_LOGIN_BONUS=50
